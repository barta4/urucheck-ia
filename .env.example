# ─────────────────────────────────────────────────────────────────────────────
# UruCheck IA — Variables de entorno
# Copiar este archivo como .env para desarrollo local.
# En Dokploy: cargar estas variables en la sección "Environment Variables".
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PASSWORD=cambia_esta_contraseña_segura

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=cambia_esta_clave_secreta_muy_larga_y_aleatoria

# ── Dominio (Traefik / Dokploy) ───────────────────────────────────────────────
# El dominio principal de la aplicación (sin https://)
DOMAIN=asistencia.tuempresa.com

# URL completa que el frontend usa para llamar a la API
# Debe coincidir con el dominio + /api
VITE_API_URL=https://asistencia.tuempresa.com/api

# URL del frontend (usada por el backend para CORS)
FRONTEND_URL=https://asistencia.tuempresa.com

# ── Zona horaria ───────────────────────────────────────────────────────────────
TIMEZONE=America/Montevideo

# ── Modo debug (solo en desarrollo, nunca en producción) ──────────────────────
DEBUG=false

# ── Integraciones opcionales ──────────────────────────────────────────────────
GEMINI_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta provista por Mercado Pago para validar webhooks HMAC:
MERCADOPAGO_WEBHOOK_SECRET=

# ── Cifrado en reposo (Fernet) ────────────────────────────────────────────────
# Clave DEDICADA e independiente de SECRET_KEY para secretos cifrados en BD
# (contraseñas SMTP, tokens MercadoPago). Rotar SECRET_KEY no los pierde.
# Generar con: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ── Semilla inicial de Super-Admin ───────────────────────────────────────────
# Usado solo en el primer arranque de la base de datos.
# Debe cumplir la política de complejidad (8+ caracteres, 1 número, 1 mayúscula);
# si no la cumple, la empresa demo NO se crea (p. ej. "admin123" es rechazada).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(12) + 'A1')"
SEED_ADMIN_PASSWORD=

# ── Verificación facial ───────────────────────────────────────────────────────
FACE_VERIFICATION_ENABLED=false
FACE_VERIFICATION_PROVIDER=face_recognition
FACE_VERIFICATION_THRESHOLD=0.6
